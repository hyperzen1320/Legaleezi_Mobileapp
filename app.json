{
  "expo": {
    "name": "Legaleezi",
    "slug": "legaleezi",
    "scheme": "legaleasy",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.legaleezi.app"
    },
    "android": {
      "package": "com.legaleezi.app",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5eed8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#f5eed8"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Legaleezi lets you attach photos of court orders and papers to a case.",
          "cameraPermission": "Legaleezi uses the camera to photograph court orders and papers for a case.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c5853a"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f331c2b-6a09-4e4c-8a74-1bf7bbdea690"
      }
    }
  }
}
